{
  "name": "moddotplot-interactive",
  "private": true,
  "version": "0.9.4",
  "type": "module",
  "engines": {
    "node": "25.9.0",
    "npm": "11.12.1"
  },
  "packageManager": "npm@11.12.1",
  "scripts": {
    "prepare:example": "node ../scripts/prepare-example-assets.mjs",
    "predev": "npm run prepare:example",
    "dev": "vite",
    "build:wasm": "wasm-pack build ../crates/wasm --target web --out-dir ../../web/src/wasm --release",
    "prebuild:ui": "npm run prepare:example",
    "build:ui": "tsc --noEmit && vite build",
    "build": "npm run build:release",
    "build:release": "npm test && npm run build:wasm && npm run build:ui && npm run docs && npm run docs:check && npm run sbom",
    "docs": "node ../scripts/generate-current-parameters.mjs",
    "docs:check": "node ../scripts/check-docs.mjs",
    "preview": "vite preview",
    "sbom": "node ../scripts/generate-sbom.mjs",
    "verify": "npm run build:release && npm run test:e2e",
    "test": "vitest run tests",
    "test:annotation-scale": "MODDOTPLOT_ANNOTATION_SCALE=1 vitest run tests/track-parser-scale.test.ts",
    "test:e2e": "playwright test --project=chromium --project=firefox --project=webkit",
    "test:e2e:chrome": "playwright test --project=chrome",
    "test:watch": "vitest"
  },
  "devDependencies": {
    "@playwright/test": "1.62.1",
    "typescript": "5.9.3",
    "vite": "7.3.6",
    "vitest": "3.2.7"
  }
}
